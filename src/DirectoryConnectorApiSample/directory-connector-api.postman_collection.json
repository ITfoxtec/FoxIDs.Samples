    {
      "name": "Authentication - login rejection",
      "item": [
        {
          "name": "English message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "en"
              }
