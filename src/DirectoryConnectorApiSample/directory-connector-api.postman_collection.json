            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rejected@somewhere.org\",\n  \"password\": \"testpass3\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/authentication",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authentication"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected authentication response\", function () {",
                  "    pm.response.to.have.status(401);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.error).to.eql(\"login_rejected\");",
                  "    pm.expect(response.uiErrorMessage).to.eql(\"You cannot log in here. Contact support.\");",
                  "    pm.expect(response.errorMessage).to.eql(\"Credentials verified; login rejected by demo directory policy.\");",
                  "});"
                ]
              }
            }
          ]
        },
